# Copy to .env — never commit .env
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: other providers in the `frontier` alias. Without a key, the gateway skips them.
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway

# Bootstrap admin key for /admin endpoints (generate: python -c "import secrets;print('gw_admin_'+secrets.token_urlsafe(24))")
GATEWAY_ADMIN_KEY=

# --- Identity (ADR 0029). All empty = only gateway API keys are accepted. ---
# The bearer token the identity provider presents to /scim/v2 (openssl rand -hex 32).
SCIM_TOKEN=
# OIDC: users call the gateway with an access token from the identity provider.
# OIDC_ISSUER is exactly the tokens' `iss`; OIDC_AUDIENCE must be in their `aud`.
# OIDC_JWKS_URL is optional (default: from the issuer's discovery document).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Which claim names the user, and which directory attribute it matches
# (external_id or user_name).
OIDC_USER_CLAIM=sub
OIDC_USER_MATCH=external_id

# Only for `make idp` (docker-compose.idp.yml: authentik as the identity provider).
# Generate each with `openssl rand -hex 32`. docker-compose.idp.yml sets the OIDC_*
# variables for the gateway itself.
GATEWAY_OIDC_CLIENT_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# The GitHub connector (docs/wiki/Connectors.md): a GitHub App with read-only access to
# pull requests. The private key stays in a file outside the repo; this is its path on
# the host (docker-compose mounts it read-only). All three empty: the connector is off.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

LOG_LEVEL=INFO
# Chaos provider for tests/demos (docker-compose sets it for the dev stack). Never in production.
# GATEWAY_ENABLE_FAKE=1
CONFIG_DIR=/app/config

# Grafana image renderer (compose profile "screenshots"); set a random value outside local dev
# GRAFANA_RENDERER_TOKEN=
# Breaker alerts (ADR 0019): a Slack-compatible incoming-webhook URL. Unset = no alerts.
ALERT_WEBHOOK_URL=
